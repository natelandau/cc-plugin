# Copy to ~/.claude/natelandau-toolkit.toml (global) or
# <project>/.claude/natelandau-toolkit.toml (per-project; project wins).
# All keys are optional; omitting the file uses the defaults shown here.

# Which tier of hooks runs: minimal | standard | strict
profile = "standard"

# Hook ids to force-off regardless of profile. Ids: branch-protection,
# protect-secrets, protect-system, protect-remote, confirm-recursive-rm,
# commit-message, config-protection, use-uv.
# e.g. disabled_hooks = ["config-protection"]
disabled_hooks = []

# --- Protected branches ---------------------------------------------------
# Branches the branch-protection hook guards in addition to main and master,
# which are always protected. Names or globs; an all-wildcard entry ("*") is
# ignored. This list only adds: the global and project lists are combined,
# so a project file can protect its own branches but never unprotect one.
#
# [hooks.branch-protection]
# protected_branches = ["develop", "release/*"]

# --- Commit message rules -------------------------------------------------
# Rules the commit-message hook applies to `git commit -m` messages and to
# `gh pr create|edit|merge` titles and bodies. The defaults shown follow
# commitlint's config-conventional. A project file may loosen these, because
# they control style, not safety.
#
# [hooks.commit-message]
# format = "conventional"            # "conventional" | "none" (skip type/format checks)
# types = ["build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor", "revert", "style", "test"]
# require_scope = false               # require `(scope)` after the type
# max_subject_length = 100            # whole first line, type and scope included; 0 = no limit
# max_body_line_length = 0            # 0 = no limit; URL lines and git trailers are exempt
# subject_case = "lower-first"        # "lower-first" | "any"
# forbid_trailing_punctuation = true  # block a subject ending in ".", "!", or "?"
# forbid_wip_subject = true           # block wip / [wip] / draft / [draft] / (draft)
# force_imperative = false            # block "added", "fixing", "bumps", ... (verbs: pretooluse/enforce_commit_message.verbs.txt)
# forbidden_patterns = []             # regexes; a match in the message, PR title, or PR body blocks
# check_pr_titles = true              # apply the subject rules to PR titles

# --- Exempt paths ---------------------------------------------------------
# Directory trees whose contents skip the branch-protection hook's
# protected-branch rules (edits, direct commits, merges) and the
# commit-message hook. Destructive git commands are still blocked inside them.
# A leading ~ is expanded; a relative or "/" entry is ignored.
#
# READ FROM THE GLOBAL FILE ONLY. A project's .claude/natelandau-toolkit.toml
# is committed inside the repository the guard protects, so this key is
# ignored there -- otherwise one repo could waive the guard for every clone.
# exempt_paths = ["~/repos/shared-context-vault"]
#
# The environment variable NATELANDAU_TOOLKIT_EXEMPT_PATHS adds to this list,
# ":"-separated, for roots that differ per machine:
#   export NATELANDAU_TOOLKIT_EXEMPT_PATHS="$SHARED_CONTEXT_VAULT"

# --- Trusted remote hosts -------------------------------------------------
# Hosts the protect-remote hook lets through without a permission prompt.
# Each entry is a hostname, ssh config alias, or IP as you type it in the
# command, or a glob such as "*.lan". Matching ignores case and any user@
# part. An entry made only of wildcards ("*") is ignored.
#
# A command runs without a prompt only when every ssh, sftp, scp, or rsync
# in it reaches a trusted host. Anything the hook cannot read still prompts:
# ansible, a host in a variable, `bash -c '...'`, an ssh run on a trusted
# host that reaches another host, and options that run a local program
# or redirect the connection (ProxyCommand, LocalCommand, HostName, scp -S,
# rsync -e <not ssh>, RSYNC_RSH, ssh -F), before or after the destination.
#
# READ FROM THE GLOBAL FILE ONLY, for the same reason as exempt_paths.
# trusted_remote_hosts = ["nas", "*.lan"]

# --- Per-project additive rules -------------------------------------------
# The protect-secrets, protect-system, protect-remote, and config-protection
# hooks also read an optional project rules file of the
# same basename as their built-in <hook>.rules.toml, from:
#
#   <project>/.claude/natelandau-toolkit/<hook>.rules.toml
#
# These rules are ADDITIVE-ONLY: they can add blocks but never weaken a
# built-in rule. A malformed project file is ignored (built-ins still apply).
#
# Example: <project>/.claude/natelandau-toolkit/protect_secrets.rules.toml
#
#   [[rule]]
#   id      = "acme-prod-conf"
#   reason  = "production secrets live in this file"
#   field   = "file_path"
#   pattern = 'acme-prod\.conf$'
#
# `pattern` may be a single regex (above) or a list of regexes (OR-combined,
# matches if any one hits): pattern = ['acme-prod\.conf$', '(?:^|/)\.acme/token$'].
#
# Match the array name to the hook's built-in file: [[rule]] for protect-secrets,
# protect-system, and protect-remote, and the
# protected_files / protected_pyproject_tables lists for config-protection.
# A protect-secrets rule must set field (or conditions);
# a bare pattern cannot match there because the hook has no single primary text.
#
# A protect-remote rule may set action = "ask" or action = "block" (default
# block) to choose whether a matching command routes to the interactive
# permission prompt or is hard-blocked.
